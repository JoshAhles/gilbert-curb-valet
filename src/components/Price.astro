---
import { SITE } from "../data/site.js";
const check = `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#b84a24" stroke="#3b2416" stroke-width="2"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff8ee" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<section class="wrap section" id="price" aria-labelledby="price-h">
  <div class="section-head">
    <p class="eyebrow">Price</p>
    <h2 id="price-h">Simple price. Better with neighbors.</h2>
  </div>
  <div class="grid">
    <div class="card price reveal">
      <div class="top">
        <p class="amt">${SITE.priceMonthly}<span>/month</span></p>
        <p class="badge">First month ${SITE.priceFirstMonth}</p>
      </div>
      <ul>
        <li><Fragment set:html={check} />Up to {SITE.maxCarts} carts, trash and recycling</li>
        <li><Fragment set:html={check} />Every pickup: out the night before, back that evening</li>
        <li><Fragment set:html={check} />No contract. Cancel anytime.</li>
      </ul>
      <a href="#join" class="ink-btn cta">Save my spot</a>
      <p class="note">Not charging anyone yet. We'll reach out before service starts.</p>
    </div>
    <div class="card refer reveal" id="refer">
      <p class="kicker">Refer a neighbor</p>
      <p class="big">Get <span>2 months</span> free.</p>
      <p class="d">When a neighbor you refer signs up and stays for one month, you get two months free. They just need to live in our Gilbert service area.</p>
      <ol class="how">
        <li><b>1</b>Share us with a neighbor</li>
        <li><b>2</b>They subscribe and stay a month</li>
        <li><b>3</b>You get 2 months free</li>
      </ol>
      <p class="fine">Starts when service opens. No limit on referrals.</p>
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(18px, 2.6vw, 32px); align-items: stretch; }
  .card { border: 2px solid #3b2416; border-radius: 26px; box-shadow: 7px 7px 0 #3b2416; padding: clamp(26px, 3.4vw, 42px); transition: transform .25s ease, box-shadow .25s ease; }
  .card:hover { transform: translate(-2px, -2px); box-shadow: 9px 9px 0 #3b2416; }
  .price { background: var(--card); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 22px; border-bottom: 2px solid color-mix(in srgb, var(--ink) 14%, transparent); }
  .amt { margin: 0; font-weight: 800; font-size: clamp(4.4rem, 9vw, 6.6rem); line-height: .85; letter-spacing: -0.05em; color: var(--price); }
  .amt span { font-size: .24em; letter-spacing: 0; color: var(--ink); margin-left: 6px; }
  .badge { margin: 0; background: #ffd8a8; color: #3b2416; font-weight: 800; padding: 8px 14px; border-radius: 999px; border: 2px solid #3b2416; }
  ul { list-style: none; padding: 0; margin: 24px 0 28px; display: grid; gap: 14px; }
  li { display: flex; gap: 12px; align-items: flex-start; font-size: 1.1rem; line-height: 1.4; color: var(--ink); }
  li :global(svg) { flex: none; width: 24px; height: 24px; margin-top: 1px; }
  .cta { display: inline-block; padding: 14px 26px; text-decoration: none; font-size: 1.08rem; }
  .note { margin: 14px 0 0; color: var(--muted); font-size: .95rem; }
  .refer { position: relative; overflow: hidden; color: #fff4e6; background:
      radial-gradient(circle at 92% 7%, #fff6d8 0 2px, transparent 3px), radial-gradient(circle at 84% 4%, #fff6d8 0 1.5px, transparent 2.5px), radial-gradient(circle at 96% 15%, #fff6d8 0 1px, transparent 2px),
      linear-gradient(160deg, #3a2a5c 0%, #241c3d 70%); }
  .kicker { margin: 0; font-size: .82rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #ffc29e; }
  .big { margin: 12px 0 14px; font-weight: 800; font-size: clamp(2.4rem, 4.6vw, 3.6rem); line-height: .95; letter-spacing: -0.04em; }
  .big span { color: #ffc29e; }
  .d { margin: 0; font-size: 1.08rem; line-height: 1.55; color: #f3e3d0; max-width: 30rem; }
  .how { list-style: none; padding: 0; margin: 24px 0 18px; display: grid; gap: 10px; }
  .how li { color: #fff4e6; font-size: 1.05rem; align-items: center; }
  .how b { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #fff4e6; color: #241c3d; font-size: .9rem; border: 2px solid #3b2416; }
  .fine { margin: 0; font-size: .92rem; color: #e6d3c0; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .card, .card:hover { transition: none; transform: none; } }
</style>
