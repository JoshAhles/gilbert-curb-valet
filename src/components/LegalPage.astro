---
import Layout from "../layouts/Layout.astro";
import Footer from "./Footer.astro";
import Logo from "./Logo.astro";
interface Props { title: string; }
const { title } = Astro.props;
---
<Layout title={`${title} | Gilbert Curb Valet`} description={`${title} for Gilbert Curb Valet.`}>
  <main class="wrap legal">
    <a href="/" class="back"><Logo size={28} /> Gilbert Curb Valet</a>
    <h1>{title}</h1>
    <slot />
  </main>
  <Footer />
</Layout>
<style>
  .legal { max-width: 720px; padding-block: 40px 60px; line-height: 1.65; font-size: 1.05rem; }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); font-weight: 900; text-decoration: none; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 28px 0 8px; }
  .legal :global(h2) { font-size: 1.3rem; margin: 28px 0 6px; }
  .legal :global(a) { color: var(--ink); font-weight: 700; }
</style>
