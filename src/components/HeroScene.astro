---
// Full-bleed scene layer. It sticks to the viewport while the hero and "How it works" scroll over it.
// The poster shows first (and for reduced motion / no WebGL / no JS); boot.js swaps in the live canvas.
---
<div class="backdrop" aria-hidden="true">
  <div class="scene" data-hero-scene>
    <picture>
      <source type="image/avif" media="(max-width: 767px)" srcset="/images/hero-poster-mobile.avif" />
      <source type="image/webp" media="(max-width: 767px)" srcset="/images/hero-poster-mobile.webp" />
      <source type="image/avif" srcset="/images/hero-poster-desktop.avif" />
      <img src="/images/hero-poster-desktop.webp" alt="" width="1600" height="1000" decoding="async" fetchpriority="low" data-poster />
    </picture>
  </div>
</div>
<style>
  .backdrop { position: sticky; top: 0; height: 100svh; margin-bottom: -100svh; z-index: 0; pointer-events: none; }
  /* Desktop: fade the scene into the sky where the text sits, so text never lies on top of the 3D. */
  .scene {
    position: absolute; inset: 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 38%, #000 62%);
    mask-image: linear-gradient(to right, transparent 0%, transparent 38%, #000 62%);
  }
  picture, img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 70% 100%; }
  img { transition: opacity .6s ease; }
  .scene :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .scene:global(.live) img { opacity: 0; }
  /* Phones: a card that sticks to the top while the steps scroll beneath it. */
  @media (max-width: 767px) {
    .backdrop { order: 2; top: 10px; height: 44svh; margin: 0 16px; z-index: 3; }
    .scene {
      -webkit-mask-image: none; mask-image: none;
      border: 2px solid var(--ink); border-radius: 20px; overflow: hidden; box-shadow: 5px 5px 0 var(--ink);
      background: linear-gradient(180deg, var(--stage-top, #ffd8a8), var(--stage-bottom, #f6e3c7));
    }
    picture, img { object-position: 50% 100%; }
  }
</style>
<script>import "../scripts/scene/boot.js";</script>
