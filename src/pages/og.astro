---
// Share-image page. render-assets screenshots it at 1200×630. Not indexed.
import Layout from "../layouts/Layout.astro";
---
<Layout noindex>
  <div class="og">
    <img src="/brand/hero-wide.webp" alt="" />
    <div class="txt">
      <p class="name">Gilbert <span>Curb Valet</span></p>
      <p class="tag">Trash night, handled.</p>
      <p class="sub">Trash can valet · Gilbert, AZ · $29 first month</p>
    </div>
  </div>
</Layout>
<style>
  .og { position: relative; width: 1200px; height: 630px; overflow: hidden; background: #ffd8a8; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 60%; }
  .txt { position: absolute; right: 60px; top: 120px; width: 560px; color: #3b2416; }
  .name { margin: 0; font-weight: 800; font-size: 76px; line-height: .95; letter-spacing: -0.035em; }
  .name span { color: #b84a24; display: block; }
  .tag { margin: 22px 0 10px; font-weight: 700; font-size: 38px; letter-spacing: -0.02em; }
  .sub { margin: 0; font-weight: 600; font-size: 22px; color: #6e3a1e; }
</style>
