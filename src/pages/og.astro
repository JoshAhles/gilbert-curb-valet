---
// Share-image page. render-assets screenshots it at 1200×630. Not indexed.
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
---
<Layout noindex>
  <div class="og">
    <div class="txt">
      <div class="brand"><Logo size={56} /><span>Gilbert Curb Valet</span></div>
      <h1>Never haul your trash cans again.</h1>
      <p>Trash can valet · Gilbert, AZ · $29 first month</p>
    </div>
    <img src="/images/hero-poster-desktop.webp" alt="" />
  </div>
</Layout>
<style>
  .og { width: 1200px; height: 630px; display: grid; grid-template-columns: 1.05fr 1fr; background: linear-gradient(180deg, #ffd8a8, #ffb88a 55%, #f6e3c7); color: #3b2416; overflow: hidden; }
  .txt { padding: 56px 24px 56px 60px; display: flex; flex-direction: column; justify-content: center; }
  .brand { display: flex; align-items: center; gap: 14px; font-weight: 900; font-size: 28px; }
  h1 { font-size: 64px; margin: 26px 0 18px; color: #3b2416; }
  p { margin: 0; font-size: 24px; font-weight: 800; color: #a8481f; }
  img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 88%; border-left: 4px solid #3b2416; }
</style>
